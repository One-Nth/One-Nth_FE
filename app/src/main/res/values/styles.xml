    <!-- 검색창 힌트 스타일 -->
    <style name="SearchHint" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textColor">@color/text_search</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- chat bottom -->
    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="BottomSheetTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="BottomSheet_NoDim_HalfHeight" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item> <!-- dim 제거 -->
        <item name="bottomSheetStyle">@style/TransparentBottomSheetStyle</item>
    </style>

    <style name="TransparentBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item> <!-- 배경 투명 -->
    </style>

    <style name="PretendardH6">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.017</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="TextAppearance.OneNthApp.Tab" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
    </style>

    //프로필 규격
    <style name="CircularShapeAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
