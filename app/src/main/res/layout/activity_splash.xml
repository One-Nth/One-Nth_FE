<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 로고 이미지 -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="93dp"
        android:layout_height="93dp"
        android:layout_marginTop="150dp"
        android:src="@drawable/logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 앱 타이틀 이미지 -->
    <ImageView
        android:id="@+id/appTitleImage"
        android:layout_width="198dp"
        android:layout_height="41.72dp"
        android:layout_marginTop="40dp"
        android:scaleType="fitXY"
        android:src="@drawable/group_44"
        app:layout_constraintTop_toBottomOf="@id/logoImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 이메일로 시작하기 버튼 (ImageButton) -->
    <ImageButton
        android:id="@+id/emailLoginBtn"
        android:layout_width="208dp"
        android:layout_height="48dp"
        android:layout_marginTop="100dp"
        android:background="@null"
        android:scaleType="fitXY"
        android:contentDescription="이메일로 시작하기"
        android:src="@drawable/emailbtn"
        app:layout_constraintTop_toBottomOf="@id/appTitleImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8" />

    <!-- kakao로 시작하기 버튼 (ImageButton) -->
    <ImageButton
        android:id="@+id/kakaoLoginBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@null"
        android:scaleType="fitXY"
        android:contentDescription="카카오로 시작하기"
        android:src="@drawable/frame_427318926"
        app:layout_constraintTop_toBottomOf="@id/emailLoginBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8" />

    <!-- 선 or 선 -->
    <LinearLayout
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintTop_toBottomOf="@id/kakaoLoginBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/text_btn_ok" />

        <TextView
            style="@style/PretendardSubtitle4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="or"
            android:textColor="@color/text_btn_ok"
            android:layout_marginHorizontal="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/text_btn_ok" />
    </LinearLayout>


    <!-- 회원가입 버튼 (ImageButton) -->
    <ImageButton
        android:id="@+id/signupBtn"
        android:layout_width="208dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@null"
        android:scaleType="fitXY"
        android:contentDescription="회원가입"
        android:src="@drawable/signupbtn"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8" />


    <!-- 계정 찾기 -->
    <TextView
        style="@style/PretendardSubtitle4"
        android:id="@+id/findAccountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="계정 찾기"
        android:textColor="@color/splash_gray"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/signupBtn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
