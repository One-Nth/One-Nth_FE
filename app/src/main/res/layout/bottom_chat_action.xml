<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="341dp"
    android:orientation="vertical"
    android:background="@drawable/rectangle_59"
    android:padding="14dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/line_13"
        android:layout_marginBottom="78dp"/>
    
    <TextView
        style="@style/PretendardSemibold2"
        android:textColor="@color/main_black"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:id="@+id/titleText"
        android:text="타이틀"
        android:textStyle="bold"
        android:textSize="20dp"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="17dp"/>

    <LinearLayout
        android:id="@+id/reportOptionsGroup"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <CheckBox
            android:layout_marginStart="40dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="욕설/성희롱 등 불쾌한 언행"/>
        <CheckBox
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_width="wrap_content"
            android:text="사기 거래 의심"/>
        <CheckBox
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_marginStart="40dp"
            android:text="불쾌한 이미지 전송"/>
        <EditText
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:hint="기타"/>
    </LinearLayout>

    <TextView
        android:layout_height="wrap_content" android:layout_width="wrap_content"
        android:id="@+id/descriptionText"
        android:text="설명"
        android:layout_marginStart="40dp"
        android:textSize="14sp"
        style="@style/PretendardBody5"
        android:textColor="#616161"
        android:layout_marginBottom="28dp"/>

    <Button
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:id="@+id/actionButton"
        android:text="버튼"
        style="@style/PretendardBody5"
        android:textSize="15dp"
        android:layout_marginBottom="104dp"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="@color/main_green"
        android:textColor="@android:color/white"/>
</LinearLayout>
