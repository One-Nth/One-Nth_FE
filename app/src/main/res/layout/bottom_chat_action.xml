<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rectangle_59">
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="341dp"
    android:orientation="vertical"
    android:background="@drawable/rectangle_59"
    android:padding="14dp">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/line_13"
        android:layout_marginBottom="78dp"/>
    
    <TextView
        style="@style/PretendardSemibold2"
        android:textColor="@color/main_black"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:id="@+id/titleText"
        android:text="타이틀"
        android:textStyle="bold"
        android:textSize="20dp"
        android:layout_gravity="center"
        android:layout_marginBottom="17dp"/>

    <LinearLayout
        android:id="@+id/reportOptionsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <!-- 신고 항목 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="욕설/성희롱 등 불쾌한 언행"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radioOption1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 신고 항목 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="사기 거래 의심"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radioOption2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 신고 항목 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="불쾌한 이미지 전송"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radioOption3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>


    <TextView
        android:layout_height="wrap_content" android:layout_width="wrap_content"
        android:id="@+id/descriptionText"
        android:text="설명"
        android:layout_gravity="center"
        android:textSize="14sp"
        style="@style/PretendardBody5"
        android:textColor="#616161"
        android:layout_marginBottom="28dp"/>

    <Button
        android:layout_height="40dp"
        android:layout_width="92dp"
        android:id="@+id/actionButton"
        android:text="버튼"
        style="@style/PretendardBody5"
        android:textSize="15dp"
        android:layout_marginBottom="104dp"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="@color/main_green"
        android:textColor="@android:color/white"/>
</LinearLayout>
</FrameLayout>