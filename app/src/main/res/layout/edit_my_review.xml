<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_white">

    <!-- 상단 앱바 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/main_white"
        app:title="후기 수정하기"
        app:titleTextColor="@color/main_black"
        app:titleTextAppearance="@style/PretendardSubtitle2"
        app:navigationIcon="@drawable/humbleicons_arrow_up"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:titleMarginStart="0dp"
        app:contentInsetStartWithNavigation="0dp"/>

    <!-- 프로필 -->
    <ImageView
        android:id="@+id/profileImage2"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/avatar"
        android:scaleType="centerCrop"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/reviewerNameDetail2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="닉네임"
        android:textSize="12sp"
        android:textColor="@color/main_black"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@id/profileImage2"
        app:layout_constraintStart_toEndOf="@id/profileImage2" />

    <!-- 상품명 -->
    <TextView
        android:id="@+id/productNameText2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="상품명"
        android:textSize="16sp"
        android:textColor="@color/main_black"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/profileImage2"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 구분선 -->
    <View
        android:id="@+id/separator"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/image_placeholder"
        app:layout_constraintTop_toBottomOf="@id/productNameText2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 별점 -->
    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:stepSize="0.5"
        android:numStars="5"
        android:scaleX="0.7"
        android:scaleY="0.7"
        android:isIndicator="true"
        android:layout_marginTop="15dp"
        android:layout_marginStart="0dp"
        android:progressTint="@color/star_yellow"
        app:layout_constraintTop_toBottomOf="@id/separator"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 후기 + 이미지 오버랩 -->
    <FrameLayout
        android:id="@+id/reviewTextContainer"
        android:layout_width="0dp"
        android:layout_height="282dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/ratingBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/reviewBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/rectangle_29"
            android:scaleType="centerCrop" />

        <EditText
            android:id="@+id/reviewTextDetail2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="연락 빠르게 보시고 상품 설명도 자세하게 해주셨어요\n~~~~\n~~~~~"
            android:textSize="14sp"
            android:textColor="@color/main_black"
            android:padding="20dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:background="@android:color/transparent"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:enabled="false" />
    </FrameLayout>


    <!-- 사진만 가로 스크롤 -->
    <HorizontalScrollView
        android:id="@+id/imageScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/reviewTextContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/imageContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- + 버튼만 고정 -->
            <FrameLayout
                android:id="@+id/addImageButton"
                android:layout_width="98dp"
                android:layout_height="93dp"
                android:layout_marginStart="0dp"
                android:background="@drawable/rectangle_32"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="12dp">

                    <ImageView
                        android:id="@+id/ivCamera"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/camera_vector" />

                    <TextView
                        android:id="@+id/tvImageCount"
                        style="@style/PretendardSubtitle2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="0/5"
                        android:textColor="#9E9E9E"/>
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- 수정 버튼 -->
    <ImageView
        android:id="@+id/editButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="90dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/editbutton"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toBottomOf="@id/imageScrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
