<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="63dp"
    android:orientation="horizontal"
    android:layout_marginStart="23dp"
    android:layout_marginEnd="27dp"
    android:layout_marginBottom="11dp"
    android:id="@+id/chatnotificationbackground"
    android:background="@drawable/edittext_border2">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="7dp"
        android:src="@drawable/chat_profile" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/nicknameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="닉네임"
            android:textColor="@color/main_black"
            android:textSize="15dp" />

        <TextView
            android:id="@+id/messageTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="어쩌고 저쩌고 여기 너무 맛있다"
            android:textColor="@color/notification_text"
            android:textSize="12dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/timeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="2초 전"
        android:textColor="@color/notification_time"
        android:textSize="12dp" />
</LinearLayout>
