<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1) 닫기 버튼 -->
    <ImageView
        android:id="@+id/btnCloseComplete"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/btn_close"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2) 체크 아이콘 -->
    <ImageView
        android:id="@+id/ivCompleteIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="100dp"
        android:src="@drawable/ic_plus_check"
        android:scaleType="fitXY"
        app:layout_constraintTop_toBottomOf="@id/btnCloseComplete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3) 안내 문구 -->
    <TextView
        android:id="@+id/tvCompleteTitle"
        android:layout_width="287dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:fontFamily="@font/pretendard_bold"
        android:text="상품이 게시판에\n등록되었어요!"
        android:textSize="25sp"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/ivCompleteIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvCompleteSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_regular"
        android:text="다른 유저들이 올린 상품도 확인해보세요."
        android:textSize="15sp"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/tvCompleteTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4) 상품 미리보기 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingVertical="12dp"
        android:paddingHorizontal="13dp"
        android:layout_marginTop="18dp"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvCompleteSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/previewImageBoxCard"
            android:layout_width="110dp"
            android:layout_height="110dp"
            app:cardCornerRadius="11dp"
            app:cardElevation="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/previewImageBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginTop="11dp"
            android:fontFamily="@font/pretendard_regular"
            android:text="두루마리 휴지"
            android:textColor="#000000"
            android:textSize="15sp"
            app:layout_constraintStart_toEndOf="@id/previewImageBoxCard"
            app:layout_constraintTop_toTopOf="@id/previewImageBoxCard" />

        <TextView
            android:id="@+id/tvProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp"
            android:fontFamily="@font/pretendard_regular"
            android:text="200원"
            android:textColor="#000000"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/tvProductName"
            app:layout_constraintTop_toBottomOf="@id/tvProductName" />

        <TextView
            android:id="@+id/tvSlash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="6dp"
            android:fontFamily="@font/pretendard_regular"
            android:text="/"
            android:textColor="#A7A0A0"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/tvProductPrice"
            app:layout_constraintBaseline_toBaselineOf="@id/tvProductPrice" />

        <TextView
            android:id="@+id/tvUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/pretendard_regular"
            android:text="개"
            android:textColor="#A7A0A0"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/tvSlash"
            app:layout_constraintBaseline_toBaselineOf="@id/tvProductPrice" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 5) 공유하기 버튼 -->
    <LinearLayout
        android:id="@+id/shareContainer"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:background="@drawable/btn_rounded_green_background"
        android:layout_marginTop="38dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/previewContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivShareIcon"
            android:layout_width="16dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_share_white"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/tvShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_regular"
            android:text="공유하기"
            android:textSize="18sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- 6) 확인 버튼 -->
    <TextView
        android:id="@+id/tvConfirm"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:background="@drawable/btn_rounded_gray_background"
        android:paddingVertical="3dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:fontFamily="@font/pretendard_regular"
        android:text="확인"
        android:textSize="18sp"
        android:textColor="#AFAFAF"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/shareContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.0" />


</androidx.constraintlayout.widget.ConstraintLayout>
