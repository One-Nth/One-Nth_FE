<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- 상단 바 -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/main_white"
            android:elevation="4dp"
            app:navigationIcon="@drawable/humbleicons_arrow_up"
            app:title="내 거래내역 및 후기"
            app:titleTextColor="@color/main_black"
            app:titleTextAppearance="@style/PretendardSubtitle2" />


        <!-- 거래 내역 요약 -->
<!--        <TextView-->
<!--            style="@style/PretendardSubtitle2"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="25dp"-->
<!--            android:text="내 거래 내역"-->
<!--            android:layout_marginTop="20dp"-->
<!--            android:layout_marginBottom="10dp"-->
<!--            android:layout_marginStart="30dp"-->
<!--            android:textColor="@color/main_black"/>-->


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp"
            android:layout_marginTop="40dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <!-- 같이 사요 박스 -->
            <FrameLayout
                android:layout_width="169dp"
                android:layout_height="127dp"
                android:layout_marginEnd="8dp">

                <!-- 박스 배경 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="같이 사요 배경"
                    android:scaleType="fitXY"
                    android:src="@drawable/rectangle_6" />

                <!-- 같이 사요 텍스트 -->
                <TextView
                    style="@style/PretendardSubtitle3"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="20dp"
                    android:text="같이사요"
                    android:textColor="@color/main_green" />

                <!-- 100 -->
                <TextView
                    android:id="@+id/purchaseDealCountText"
                    style="@style/PretendardH2"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="48dp"
                    android:text="100건"
                    android:textColor="@color/main_black" />

                <!-- 20,000회 거래 + 화살표 묶음 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="88dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/purchaseDealAmountText"
                        style="@style/PretendardBody1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20,000"
                        android:textColor="@color/N_saved_gray" />
                    <TextView
                        style="@style/PretendardBody1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="회 거래"
                        android:textColor="@color/N_saved_gray" />
                </LinearLayout>

            </FrameLayout>


            <!-- 함께 나눠요 박스 -->
            <FrameLayout
                android:layout_width="169dp"
                android:layout_height="127dp"
                android:layout_marginStart="8dp">

                <!-- 박스 배경 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="함께 나눠요 배경"
                    android:scaleType="fitXY"
                    android:src="@drawable/rectangle_6" />

                <!-- 함께 나눠요 텍스트 -->
                <TextView
                    style="@style/PretendardSubtitle3"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="20dp"
                    android:text="함께 나눠요"
                    android:textColor="@color/main_green" />

                <!-- 50 -->
                <TextView
                    android:id="@+id/shareDealCountText"
                    style="@style/PretendardH2"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="48dp"
                    android:text="100건"
                    android:textColor="#000000" />


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="88dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/shareDealAmountText"
                        style="@style/PretendardBody1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20,000"
                        android:textColor="@color/N_saved_gray" />
                    <TextView
                        style="@style/PretendardBody1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="회 거래"
                        android:textColor="@color/N_saved_gray" />
                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="@color/btn_ok" />


        <!-- 구매자 거래 후기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="0dp">

            <TextView
                style="@style/PretendardSemibold2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="구매자 거래 후기"
                android:layout_weight="1"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:layout_marginStart="5dp"
                android:textColor="@color/main_black" />

            <ImageView
                android:id="@+id/btnGoAllReviews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/right_arrow"
                android:contentDescription="더보기" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/buyerReviewRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:paddingStart="5dp"
            android:paddingBottom="12dp"
            android:overScrollMode="never"
            android:scrollbars="horizontal" />

        <FrameLayout
            android:layout_width="350dp"
            android:layout_height="7dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center_horizontal">>

            <!-- 회색 배경 전체 -->
            <View
                android:layout_width="350dp"
                android:layout_height="7dp"
                android:background="#D9D9D9" />

            <!-- 검정 진행 바 (동적으로 width 변경) -->
            <View
                android:id="@+id/scrollBar"
                android:layout_width="80dp"
                android:layout_height="7dp"
                android:background="#000000" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F4F4F4"
            android:layout_marginTop="30dp"
            android:paddingTop="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <TextView
                style="@style/PretendardSubtitle1"
                android:id="@+id/editMyReviewText"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart"
                android:layout_width="336dp"
                android:layout_height="24dp"
                android:text="후기를 작성할래요"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:textColor="@color/main_black"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/editReviewRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:overScrollMode="never"
                android:scrollbars="none" />
        </LinearLayout>
        </LinearLayout>
</ScrollView>
