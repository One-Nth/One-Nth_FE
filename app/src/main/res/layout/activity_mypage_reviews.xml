<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 상단 바 -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/main_white"
            android:elevation="4dp"
            app:navigationIcon="@drawable/humbleicons_arrow_up"
            app:title="프로필"
            app:titleTextColor="@color/main_black"
            app:titleTextAppearance="@style/PretendardSubtitle2" />

        <!-- 상단 프로필 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/profile_base"
                android:layout_marginEnd="12dp"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/PretendardSemibold4"
                    android:id="@+id/nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="abcd123"
                    android:textColor="@color/main_black" />

                <TextView
                    style="@style/PretendardSemibold5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OO동 인증 완료"
                    android:textColor="@color/main_green_2" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#D9D9D9" />


        <!-- 거래 내역 요약 전체 Wrapper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical"
            android:paddingVertical="16dp"
            android:paddingStart="20dp"
            android:layout_marginTop="0dp"
            android:paddingEnd="16dp">

            <!-- 상단 텍스트 + 화살표 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="0dp">

                <TextView
                    style="@style/PretendardSemibold2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:textAlignment="viewStart"
                    android:text="거래 내역"
                    android:textColor="@color/main_black" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/right_arrow"
                    android:contentDescription="더보기" />
            </LinearLayout>

            <!-- 박스 2개 (판매 / 리뷰) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="0dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- 판매 박스 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="101dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="판매"
                            android:textColor="@color/N_saved_gray"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/sellCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100"
                            android:textColor="@color/main_black"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 리뷰 박스 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="101dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="리뷰"
                            android:textColor="@color/N_saved_gray"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/reviewCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50"
                            android:textColor="@color/main_black"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#D9D9D9" />

        <!-- 구매자 거래 후기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="0dp">

            <TextView
                style="@style/PretendardSemibold2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="구매자 거래 후기"
                android:layout_weight="1"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:layout_marginStart="5dp"
                android:textColor="@color/main_black" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/right_arrow"
                android:contentDescription="더보기" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/buyerReviewRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="5dp"
            android:paddingBottom="12dp"
            android:overScrollMode="never"
            android:scrollbars="horizontal" />

        <FrameLayout
            android:layout_width="350dp"
            android:layout_height="7dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center_horizontal">>

            <!-- 회색 배경 전체 -->
            <View
                android:layout_width="350dp"
                android:layout_height="7dp"
                android:background="#D9D9D9" />

            <!-- 검정 진행 바 (동적으로 width 변경) -->
            <View
                android:id="@+id/scrollBar"
                android:layout_width="80dp"
                android:layout_height="7dp"
                android:background="#000000" />
        </FrameLayout>

    </LinearLayout>
</ScrollView>
