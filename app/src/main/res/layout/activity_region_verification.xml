<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 툴바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="81dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="31dp"
            android:layout_height="31dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="27dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            android:src="@drawable/ic_arrow_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/titleText"
            style="@style/PretendardSubtitle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="동네 인증 하기"
            android:textColor="@color/main_black"
            app:layout_constraintBottom_toBottomOf="@id/backButton"
            app:layout_constraintStart_toEndOf="@id/backButton"
            app:layout_constraintTop_toTopOf="@id/backButton" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.kakao.vectormap.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="180dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- 2) 고정된 하단 컨테이너 (바텀시트 대신) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="20dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 드래그 핸들 모양 -->
        <View
            android:id="@+id/scroll_bar"
            android:layout_width="80dp"
            android:layout_height="4dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/ic_scrollbar_bar"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="44dp"
            android:layout_marginTop="37dp"
            android:layout_marginBottom="7dp"
            android:layout_weight="1"
            android:fontFamily="@font/pretendard_bold"
            android:text="우리 동네"
            android:textColor="@color/main_black"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="@id/scroll_bar" />

        <!-- 1) 선택된 지역 칩 영역 -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/flexSelected"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="50dp"
            android:layout_marginTop="25dp"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <!-- 지역 인증하기 버튼 -->
        <TextView
            android:id="@+id/btnAuthenticateRegion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="45dp"
            android:layout_marginEnd="45dp"
            android:layout_marginTop="20dp"
            android:text="동네 인증하기"
            android:textColor="@color/main_green_3"
            android:textSize="17sp"
            android:fontFamily="@font/pretendard_semibold"
            app:drawableEndCompat="@drawable/ic_right_green"
            android:drawablePadding="8dp"
            app:layout_constraintTop_toBottomOf="@id/flexSelected"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvAuthSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="동네 인증을 하면 프로필에 인증 뱃지를 표시할 수 있어요"
            android:textColor="@color/main_green_3"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_regular"
            app:layout_constraintStart_toStartOf="@id/btnAuthenticateRegion"
            app:layout_constraintTop_toBottomOf="@id/btnAuthenticateRegion"
            />


        <!-- 선택 화면 요소를 한 번에 숨기기 위한 Group -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupSelect"
            android:visibility="visible"
            app:constraint_referenced_ids="title, flexSelected,btnAuthenticateRegion,tvAuthSub"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

        <!-- ========== [상태 B] 결과 화면 (성공/실패 + 하단 CTA) ========== -->

        <!-- 성공 텍스트 -->
        <TextView
            android:id="@+id/tvSuccess"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="45dp"
            android:layout_marginEnd="45dp"
            android:layout_marginTop="60dp"
            android:text="현재 위치가 내 동네로 설정된 OO동에 있습니다."
            android:textColor="@color/main_black"
            android:textSize="16sp"
            android:fontFamily="@font/pretendard_semibold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scroll_bar" />

        <TextView
            android:id="@+id/tvFail"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="현재 위치가 내 동네로 설정된 OO동에 있지 않습니다."
            android:paddingHorizontal="10dp"
            android:gravity="center_vertical"
            android:layout_marginTop="60dp"
            android:background="@color/light_red"
            android:textColor="@color/main_black"
            android:textSize="16sp"
            android:visibility="gone"
            android:fontFamily="@font/pretendard_semibold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scroll_bar" />

        <TextView
            android:id="@+id/tvFailNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="* 사용자의 위치가 인증할 동네 범위 안에 포함되어야 합니다."
            android:textColor="@color/light_gray"
            android:textSize="14sp"
            android:visibility="gone"
            android:fontFamily="@font/pretendard_regular"
            app:layout_constraintEnd_toEndOf="@id/tvFail"
            app:layout_constraintStart_toStartOf="@id/tvFail"
            app:layout_constraintTop_toBottomOf="@id/tvFail" />
        <!-- 하단 CTA: 성공 시 -->
        <Button
            android:id="@+id/btnVerifyDone"
            android:layout_width="209dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="45dp"
            android:layout_marginBottom="30dp"
            android:text="동네 인증 완료하기"
            android:textAllCaps="false"
            android:fontFamily="@font/pretendard_regular"
            app:cornerRadius="10dp"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:backgroundTint="@color/main_green"
            android:textColor="@color/main_white"
            android:visibility="gone"/>

        <!-- 하단 CTA: 실패 시 (비활성) -->
        <Button
            android:id="@+id/btnChangeNotAllowed"
            android:layout_width="209dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="45dp"
            android:layout_marginBottom="30dp"
            android:text="동네 변경 불가"
            android:textAllCaps="false"
            android:fontFamily="@font/pretendard_regular"
            app:cornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:backgroundTint="@color/main_gray"
            android:textColor="@color/dark_gray"
            android:visibility="gone"/>

        <!-- 결과 화면 요소를 한 번에 토글하기 위한 Group -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupResult"
            android:visibility="gone"
            app:constraint_referenced_ids="tvSuccess,btnVerifyDone,btnChangeNotAllowed"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>