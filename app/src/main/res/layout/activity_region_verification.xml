<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 툴바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="81dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="31dp"
            android:layout_height="31dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="27dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            android:src="@drawable/ic_arrow_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/titleText"
            style="@style/PretendardSubtitle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="동네 인증 하기"
            android:textColor="@color/main_black"
            app:layout_constraintBottom_toBottomOf="@id/backButton"
            app:layout_constraintStart_toEndOf="@id/backButton"
            app:layout_constraintTop_toTopOf="@id/backButton" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.kakao.vectormap.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="280dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- 2) 고정된 하단 컨테이너 (바텀시트 대신) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="341dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="20dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 드래그 핸들 모양 -->
        <View
            android:id="@+id/scroll_bar"
            android:layout_width="80dp"
            android:layout_height="4dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/ic_scrollbar_bar"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="44dp"
            android:layout_marginTop="58dp"
            android:layout_marginBottom="7dp"
            android:layout_weight="1"
            android:fontFamily="@font/pretendard_bold"
            android:text="우리 동네"
            android:textColor="@color/main_black"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="@id/scroll_bar" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="현재 위치가 내 지역으로 등록된 OO동에 있습니다."
            android:textColor="#606060"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="@id/bottom_container"
            app:layout_constraintStart_toStartOf="@id/bottom_container"
            app:layout_constraintTop_toBottomOf="@id/title" />
        <!-- 1) 선택된 지역 칩 영역 -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/flexSelected"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginStart="45dp"
            android:layout_marginTop="32dp"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detail" />

        <!-- 지역 인증하기 버튼 -->
        <Button
            android:id="@+id/btnAuthenticateRegion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="45dp"
            android:layout_marginEnd="45dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_rounded_green_background"
            android:text="지역 인증하기"
            android:textColor="@color/main_white"
            android:textSize="16sp"
            android:fontFamily="@font/pretendard_medium"
            app:layout_constraintTop_toBottomOf="@id/flexSelected"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

