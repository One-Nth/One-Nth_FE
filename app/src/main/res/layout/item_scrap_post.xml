<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="12dp"
    android:paddingHorizontal="8dp">

    <!-- 카테고리 태그 -->
    <TextView
        android:id="@+id/tvCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="73dp"
        android:minHeight="24dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="@drawable/post_category_border"
        android:gravity="center"
        android:text="생활 정보"
        android:textSize="12sp"
        android:textColor="#419461"
        android:includeFontPadding="false"/>


    <!-- 제목 + 시간 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:gravity="start|center_vertical"
            android:textAlignment="viewStart"
            style="@style/PretendardH3"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="OOO카페"
            android:textColor="@color/main_black" />

        <TextView
            style="@style/PretendardSubtitle4"
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3분전"
            android:textColor="@color/light_gray" />
    </LinearLayout>

    <!-- 내용 -->
    <TextView
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="000카페 아메리카노 2000원 행사해요~"
        android:textSize="14sp"
        android:textColor="@color/main_black"
        android:layout_marginTop="2dp" />

    <!-- 댓글/좋아요/조회수 + 오른쪽 끝 이미지 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <!-- 왼쪽 : 댓글/좋아요/조회수 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_board_comment" />

            <TextView
                style="@style/PretendardSubtitle4"
                android:id="@+id/tvCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="@color/main_black"
                android:layout_marginStart="4dp"/>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_board_like"
                android:layout_marginStart="12dp" />

            <TextView
                style="@style/PretendardSubtitle4"
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@color/main_black"
                android:layout_marginStart="4dp"/>

            <TextView
                style="@style/PretendardSubtitle4"
                android:id="@+id/tvViews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="조회수 24"
                android:textColor="@color/light_gray"
                android:layout_marginStart="12dp"/>
        </LinearLayout>

        <!-- 오른쪽 끝 이미지 -->
        <ImageView
            android:id="@+id/ivExtra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:src="@drawable/edit_post"/>
    </LinearLayout>


    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/back_gray"/>

</LinearLayout>
