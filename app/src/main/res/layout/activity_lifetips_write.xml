<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_life_tips_common"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_white"
    android:orientation="vertical">

    <!-- 툴바 -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/main_white"
        android:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:contentDescription="뒤로가기"
                android:src="@drawable/humbleicons_arrow_up"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitleBar"
                style="@style/PretendardSubtitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="글쓰기"
                android:textColor="@color/main_black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivBack"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 우측 액션(올리기/수정 등) -->
            <TextView
                android:id="@+id/iv_notification"
                style="@style/PretendardBody5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="올리기"
                android:textColor="@color/main_green"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="15dp"
        android:background="#CCCCCC" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 사진 추가 -->
            <LinearLayout
                android:id="@+id/photoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cameraTile"
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:background="@drawable/rectangle_11"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="40dp"
                        android:src="@drawable/camera_vector" />

                    <TextView
                        android:id="@+id/tvImageCount"
                        style="@style/PretendardSubtitle2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="0/5"
                        android:textColor="@color/text_btn_ok" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/thumbsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 제목 / 내용 -->
            <EditText
                android:id="@+id/etTitle"
                style="@style/PretendardH2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:hint="제목"
                android:padding="8dp"
                android:inputType="textMultiLine"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart"
                android:textColorHint="@color/splash_gray"
                android:textColor="@color/main_black"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etContent"
                style="@style/PretendardSubtitle2"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@android:color/transparent"
                android:gravity="start|top"
                android:hint="내용 입력하기"
                android:textAlignment="viewStart"
                android:inputType="textMultiLine"
                android:overScrollMode="ifContentScrolls"
                android:padding="8dp"
                android:textColorHint="@color/splash_gray"
                android:textColor="@color/main_black"
                android:textSize="16sp" />

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:background="@color/main_gray" />

            <!-- 링크 섹션 (LIFE_TIP 전용) -->
            <LinearLayout
                android:id="@+id/sectionLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvLinkHeader"
                    style="@style/PretendardSubtitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:text="링크 삽입"
                    android:textColor="@color/main_black" />

                <LinearLayout
                    android:id="@+id/linkInputContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivLinkIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_search_glasses"
                        app:tint="@color/text_search" />

                    <EditText
                        android:id="@+id/etLink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="링크를 입력하고 엔터로 확정"
                        android:imeOptions="actionDone"
                        android:inputType="textUri"
                        android:textColor="@color/main_black"
                        android:textColorHint="@color/text_search"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:singleLine="true"
                app:singleSelection="true"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

            <!-- 장소 섹션 (DISCOUNT/RESTAURANT 전용) -->
            <LinearLayout
                android:id="@+id/sectionLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLocationHeader"
                    style="@style/PretendardSubtitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:text="장소 추가하기"
                    android:textColor="@color/main_black" />

                <LinearLayout
                    android:id="@+id/locationSearchContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:id="@+id/ivLocationIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_search_glasses"
                        app:tint="@color/text_search" />

                    <EditText
                        android:id="@+id/etLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="주소를 입력하고 엔터로 확정"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:textColor="@color/main_black"
                        android:textColorHint="@color/text_search"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:singleLine="true"
                app:singleSelection="true"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

            <!-- 태그 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="60dp"
                android:background="@color/main_gray" />

            <TextView
                android:id="@+id/tvTagHeader"
                style="@style/PretendardSemibold4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="# 태그"
                android:textColor="@color/main_black" />

            <LinearLayout
                android:id="@+id/tagsInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvHashPrefix"
                    style="@style/PretendardBody5"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="#"
                    android:textColor="@color/main_black" />

                <EditText
                    android:id="@+id/etTags"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="태그를 입력하고 엔터/쉼표로 확정"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/main_black"
                    android:textColorHint="@color/text_search"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
