<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 검색 툴바 -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/search_toolbar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@color/main_white"
            android:contentInsetStart="8dp"
            android:contentInsetEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <!-- 뒤로가기 -->
                <ImageButton
                    android:id="@+id/btn_back_expanded"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_left" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar">
                    <!-- 검색어 표시 -->
                    <TextView
                        android:id="@+id/tv_search_keyword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text=""
                        android:textColor="@color/main_black"
                        android:textSize="16sp" />

                    <!-- 검색어 삭제 버튼 -->
                    <ImageButton
                        android:id="@+id/btn_clear_search"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="20dp"
                        android:layout_gravity="center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="검색어 삭제"
                        android:src="@drawable/ic_clear" />
                </LinearLayout>
                <!-- 닫기 -->
                <TextView
                    android:id="@+id/btn_close_expanded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="26dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/pretendard_semibold"
                    android:text="닫기"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- TabLayout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout_home"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/main_white"
            app:tabIndicatorColor="@color/main_green"
            app:tabIndicatorFullWidth="false"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/main_green"
            app:tabTextAppearance="@style/TextAppearance.OneNthApp.Tab">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="같이 사요" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="함께 나눠요" />

        </com.google.android.material.tabs.TabLayout>

        <!-- 검색 결과 리스트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="visible" />

        <!-- 상세 전용 NavHost (이 액티비티 내부 내비게이션) -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/search_nav_host"
            android:name="androidx.navigation.fragment.NavHostFragment"
            app:navGraph="@navigation/nav_search_detail"
            app:defaultNavHost="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- 검색 결과 없음 메시지 -->
        <TextView
            android:id="@+id/tv_no_results"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="검색 결과가 없습니다."
            android:textColor="@color/main_gray"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- 로딩 프로그레스바 -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
