<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:style="http://schemas.android.com/tools">

    <!-- 상단 바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatTopToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include layout="@layout/chat_top_toolbar" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <!-- 채팅 내용 리스트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="44dp"
        android:backgroundTint="#FFFF0000"
        app:layout_constraintTop_toBottomOf="@id/chatTopToolbar"
        app:layout_constraintBottom_toTopOf="@id/inputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

    <!-- 입력창 -->
    <LinearLayout
        android:id="@+id/inputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="28dp"
        android:background="@color/main_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageButton
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="15dp"
            android:src="@drawable/tabler_photo"
            android:background="@null"
            android:layout_marginTop="4dp"
            android:contentDescription="사진 전송"/>

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="280dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/rectangle_41"
            android:layout_marginStart="11dp"/>

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="13dp"
            android:layout_height="14.16dp"
            android:src="@drawable/vector"
            android:background="@null"
            android:layout_marginStart="18dp"
            android:layout_marginTop="13.84dp"
            android:layout_marginEnd="24dp"
            android:contentDescription="메시지 전송" />
    </LinearLayout>
    <!-- 입력창 -->
    <LinearLayout
        android:id="@+id/inputLayoutGone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="134dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageButton
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="15dp"
            android:src="@drawable/tabler_photo"
            android:background="@null"
            android:layout_marginTop="4dp"
            android:contentDescription="사진 전송"/>

        <EditText
            android:id="@+id/messageInputGone"
            android:layout_width="280dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/rectangle_41"
            android:layout_marginStart="11dp"/>

        <ImageButton
            android:id="@+id/btnSendGone"
            android:layout_width="13dp"
            android:layout_height="14.16dp"
            android:src="@drawable/vector"
            android:background="@null"
            android:layout_marginStart="18dp"
            android:layout_marginTop="13.84dp"
            android:layout_marginEnd="24dp"
            android:contentDescription="메시지 전송" />
    </LinearLayout>

    <ImageView
        android:visibility="gone"
        android:id="@+id/img_bottom_box"
        android:layout_width="324dp"
        android:layout_height="134dp"
        android:layout_marginBottom="50dp"
        android:src="@drawable/rectangle_40__1_"
        app:layout_constraintBottom_toTopOf="@id/chatMenuContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ImageView
        android:visibility="gone"
        android:layout_marginTop="22dp"
        android:id="@+id/completereivew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/cancel_notification"
        app:layout_constraintStart_toStartOf="@+id/img_bottom_box"
        android:layout_marginStart="41dp"
        android:src="@drawable/completereview"/>
<ImageView
    android:visibility="gone"
    android:layout_marginTop="22dp"
    android:id="@+id/completensave"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="13dp"
    app:layout_constraintStart_toEndOf="@+id/completereivew"
    app:layout_constraintTop_toBottomOf="@id/cancel_notification"
    android:src="@drawable/completensave"/>
    <TextView
        android:visibility="gone"
        style="@style/PretendardSemibold4"
        android:id="@+id/cancel_notification"
        android:layout_width="285dp"
        android:layout_height="wrap_content"
     android:textColor="@color/main_green"
      android:gravity="center_horizontal"
        android:text="휴지의 거래 확정폼을 작성했어요."
        app:layout_constraintTop_toTopOf="@+id/img_bottom_box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="23dp"
        />
    <ImageView
        android:id="@+id/check_deal_cancel_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cancel_btn"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/cancel_notification"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    
    <FrameLayout
        android:id="@+id/chatMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="134dp"
        android:background="@color/main_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
