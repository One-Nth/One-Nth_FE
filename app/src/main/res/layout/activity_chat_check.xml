<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_white">

    <!-- 툴바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="81dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="13.64dp"
            android:layout_marginTop="18.29dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="뒤로가기"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            style="@style/PretendardSubtitle2"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="닉네임"
            android:textColor="@color/main_black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginLeft="30dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_left"
            app:layout_constraintTop_toTopOf="@id/btn_left"
            app:layout_constraintStart_toEndOf="@id/btn_left"
            app:layout_constraintHorizontal_bias="0.5" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- 거래 확정 텍스트 -->
    <TextView
        style="@style/PretendardH6"
        android:id="@+id/checktitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="거래를 확정했어요!"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginStart="6dp"
        android:textColor="@color/main_green"
        app:layout_constraintTop_toBottomOf="@+id/chat_toolbar"
        app:layout_constraintStart_toEndOf="@id/checkimg"
        android:layout_marginTop="39dp" />

    <ImageView
        android:id="@+id/checkimg"
        android:layout_marginStart="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/checktitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/lets_icons_check_fill"/>

    <!-- 거래 날짜 라벨 -->
    <TextView
        style="@style/PretendardSemibold4"
        android:id="@+id/dealDateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="거래를 확정할 상품을 선택해주세요"
        android:textSize="18sp"
        android:textColor="@color/main_green"
        app:layout_constraintTop_toBottomOf="@id/checktitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginTop="27dp"/>

    <!-- 상품 선택 드롭다운 -->
    <AutoCompleteTextView
        android:id="@+id/productDropdown"
        android:layout_width="311dp"
        android:layout_height="40dp"
        android:hint="상품 선택하기"
        android:backgroundTint="#f4f4f4"
        android:paddingStart="30dp"
        style="@style/PretendardBody8"
        android:inputType="none"
        android:dropDownHeight="334dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/dealDateLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="26dp"
        android:drawableEnd="@drawable/icon_dropbox_down"
        android:dropDownVerticalOffset="4dp"
        android:dropDownWidth="314dp"
        />

    <include
        android:id="@+id/itemDropdownProduct"
        layout="@layout/item_dropdown_product"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/productDropdown"
        app:layout_constraintTop_toBottomOf="@+id/productDropdown"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        style="@style/PretendardSemibold4"
        android:id="@+id/deal_method"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="거래 방식을 선택해주세요"
        android:textSize="18sp"
        android:textColor="@color/main_green"
        app:layout_constraintTop_toBottomOf="@+id/itemDropdownProduct"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginTop="26dp"/>

    <!-- 만나서 거래할래요 버튼 -->
    <Button
        style="@style/PretendardSemibold3"
        android:id="@+id/inpersonButton"
        android:layout_width="156dp"
        android:layout_height="60dp"
        android:text="만나서 거래할래요"
        android:textColor="#419461"
        android:backgroundTint="#EDF9F2"
        app:layout_constraintTop_toBottomOf="@id/deal_method"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="9dp"
        android:layout_marginStart="30dp"/>

    <!-- 택배로 거래할래요 버튼 -->
    <Button
        style="@style/PretendardSemibold3"
        android:id="@+id/deliveryButton"
        android:layout_width="156dp"
        android:layout_height="60dp"
        android:text="택배로 거래할래요"
        android:textColor="#AFAFAF"
        android:backgroundTint="#F0F0F0"
        app:layout_constraintTop_toBottomOf="@id/deal_method"
        app:layout_constraintStart_toEndOf="@id/inpersonButton"
        android:layout_marginStart="17dp"
        android:layout_marginTop="9dp"/>

    <!-- 상품 금액 라벨 -->
    <TextView
        style="@style/PretendardSemibold4"
        android:id="@+id/deal_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="거래 날짜"
        android:textSize="18sp"
        android:textColor="@color/main_green"
        app:layout_constraintTop_toBottomOf="@id/inpersonButton"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="26dp"
        android:layout_marginTop="31dp"/>

    <EditText
        android:id="@+id/dateInput"
        style="@style/PretendardBody8"
        android:layout_width="311dp"
        android:layout_height="34dp"
        android:background="#f4f4f4"
        android:paddingStart="12dp"
        android:hint="2025-05-28"
        android:textColor="@color/main_black"
        android:textColorHint="@color/main_black"
        app:layout_constraintTop_toBottomOf="@id/deal_date"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="26dp"
        android:layout_marginTop="8dp" />
    <!-- 상품 금액 라벨 -->
    <TextView
        style="@style/PretendardSemibold4"
        android:id="@+id/deal_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="상품 구매 금액"
        android:textSize="18sp"
        android:textColor="@color/main_green"
        app:layout_constraintTop_toBottomOf="@id/dateInput"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="26dp"
        android:layout_marginTop="20dp"/>

    <!-- 상품 금액 입력 -->
    <EditText
        android:id="@+id/priceInput"
        style="@style/PretendardBody8"
        android:layout_width="311dp"
        android:layout_height="34dp"
        android:background="#f4f4f4"
        android:paddingStart="12dp"
        android:hint="종합 가격을 입력해주세요"
        android:textColor="@color/main_black"
        android:textColorHint="#AFAFAF"
        app:layout_constraintTop_toBottomOf="@id/deal_price"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="26dp"
        android:layout_marginTop="8dp" />
    <!-- 상품 금액 라벨 -->
    <TextView
        style="@style/PretendardSemibold4"
        android:id="@+id/deal_original_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="상품 원가"
        android:textSize="18sp"
        android:textColor="@color/main_green"
        app:layout_constraintTop_toBottomOf="@id/priceInput"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="26dp"
        android:layout_marginTop="20dp"/>

    <!-- 상품 금액 입력 -->
    <EditText
        android:id="@+id/originalpriceInput"
        style="@style/PretendardBody8"
        android:layout_width="311dp"
        android:layout_height="34dp"
        android:background="#f4f4f4"
        android:paddingStart="12dp"
        android:hint="단위당 원가를 입력해주세요"
        android:textColor="@color/main_black"
        android:textColorHint="#AFAFAF"
        app:layout_constraintTop_toBottomOf="@id/deal_original_price"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="26dp"
        android:layout_marginTop="8dp" />
    <!-- 거래 완료 버튼 -->
    <Button
        android:id="@+id/completeButton"
        style="@style/PretendardSemibold3"
        android:layout_width="150dp"
        android:layout_height="40dp"
        android:text="저장하기"
        android:textSize="15dp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/main_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/originalpriceInput"
        android:layout_marginTop="50dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>

