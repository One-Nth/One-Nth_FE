<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_life_tips_search"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/main_white"
    tools:context=".LifeTipsSearchActivity">

    <!-- 툴바 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_search_result"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/main_white"
        android:elevation="0dp"
        app:navigationIcon="@drawable/humbleicons_arrow_up"
        app:titleTextColor="@color/main_black"
        app:titleTextAppearance="@style/PretendardSubtitle2"
        app:titleCentered="false"
        app:contentInsetStartWithNavigation="0dp" />

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC" />

    <!-- 지역 필터링 섹션 (할인/맛집 게시판에서만 표시) -->
    <LinearLayout
        android:id="@+id/ll_region_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:orientation="vertical"
        android:background="@color/main_white"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="우리동네에 등록된 게시글을 모아볼 수 있어요"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="@color/main_black"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_region_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            app:chipSpacingHorizontal="18dp"
            app:chipSpacingVertical="12dp"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="20dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_region_1"
                style="@style/Widget.App.CustomChoiceChip"
                android:text="OO동"
                app:chipBackgroundColor="@color/custom_chip_background_color"
                app:chipCornerRadius="10dp"
                app:chipStartPadding="20dp"
                app:chipEndPadding="20dp"
                app:chipMinHeight="32dp"
                app:chipStrokeColor="@color/custom_chip_stroke_color"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_region_2"
                style="@style/Widget.App.CustomChoiceChip"
                android:text="OO동"
                app:chipBackgroundColor="@color/custom_chip_background_color"
                app:chipCornerRadius="10dp"
                app:chipStartPadding="20dp"
                app:chipEndPadding="20dp"
                app:chipMinHeight="32dp"
                app:chipStrokeColor="@color/custom_chip_stroke_color"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_region_3"
                style="@style/Widget.App.CustomChoiceChip"
                android:text="OO동"
                app:chipBackgroundColor="@color/custom_chip_background_color"
                app:chipCornerRadius="10dp"
                app:chipMinHeight="32dp"
                app:chipStartPadding="20dp"
                app:chipEndPadding="20dp"
                app:chipStrokeColor="@color/custom_chip_stroke_color"
                app:chipStrokeWidth="1dp" />

        </com.google.android.material.chip.ChipGroup>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="15dp"
            android:background="#CCCCCC" />
    </LinearLayout>

    <!-- 검색 결과 리스트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="10dp"
        android:clipToPadding="false"
        android:background="@color/main_white"
        android:layout_marginTop="10dp"/>
</LinearLayout>