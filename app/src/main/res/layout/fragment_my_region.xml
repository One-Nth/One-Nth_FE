<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/include_toolbar"
        layout="@layout/layout_toolbar_myregion"
        android:layout_width="match_parent"
        android:layout_height="68dp" />

    <com.kakao.vectormap.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2) 고정된 하단 컨테이너 (바텀시트 대신) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="341dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 드래그 핸들 모양 -->
        <View
            android:id="@+id/scroll_bar"
            android:layout_width="80dp"
            android:layout_height="4dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/ic_scrollbar_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="44dp"
            android:layout_marginTop="78dp"
            android:layout_marginBottom="7dp"
            android:layout_weight="1"
            android:fontFamily="@font/pretendard_bold"
            android:text="우리동네로 설정할 지역을 입력하세요."
            android:textColor="@color/main_black"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="@id/scroll_bar" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="현재 위치 반경 OOkm 이내만  등록 가능해요."
            android:textColor="#606060"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="@id/bottom_container"
            app:layout_constraintStart_toStartOf="@id/bottom_container"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <!-- 1) 선택된 지역 칩 영역 -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/flexSelected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:layout_constraintTop_toBottomOf="@id/detail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 2) 검색창 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/search_bar"
            android:layout_width="362dp"
            android:layout_height="35dp"
            android:layout_marginStart="19dp"
            android:layout_marginEnd="19dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/flexSelected"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/search_gray"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search_glasses"
                    app:tint="@color/text_search" />

                <EditText
                    android:id="@+id/search_bar_et"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="추가할 지역을 입력해주세요"
                    android:textColor="@color/main_black"
                    android:textColorHighlight="@color/main_green_3"
                    android:textColorHint="@color/text_search"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3) 검색 결과 리스트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSuggestions"
            android:layout_width="0dp"
            android:layout_height="215dp"
            android:layout_marginTop="4dp"
            android:background="@color/main_white"
            android:elevation="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/search_bar"
            app:layout_constraintStart_toStartOf="@id/search_bar"
            app:layout_constraintEnd_toEndOf="@id/search_bar"/>
