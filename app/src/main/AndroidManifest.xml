<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 위치 정보 사용 권한 (선택 사항, 필요에 따라 추가) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ✅ 인터넷 권한 추가 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:usesCleartextTraffic="true"
        android:name=".GlobalApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_main_logo"
        android:label="N분의 1"
        android:roundIcon="@drawable/ic_main_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme_OneNthApp"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme_OneNthApp">

            <!--
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            -->
        </activity>

        <activity android:name=".feature.alarm.AlarmActivity" android:exported="false" />
        <activity android:name=".MyReviewActivity" android:exported="false" />
        <activity android:name=".BuyerReview" />
        <activity android:name=".feature.chat.ChatActivity" />
        <activity android:name=".EditMyReviewActivity" />
        <activity android:name=".feature.mypage.SettingsActivity" />
        <activity android:name=".feature.mypage.AlertSettingsActivity" />
        <activity android:name=".feature.mypage.AccountSettingsActivity" />
        <activity android:name=".feature.mypage.BlockedUsersActivity" />
        <activity android:name=".feature.mypage.PolicyActivity" />
        <activity android:name=".feature.board.LifeTipsSearchActivity" />
        <activity android:name=".feature.board.LifeTipsDetailActivity" />
        <activity android:name=".feature.chat.ChatCheckActivity" />
        <activity android:name=".feature.chat.ChatBlockActivity"/>

        <activity
            android:name=".feature.chat.ChatRoomActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".feature.signup.SignupActivity" android:exported="false" />
        <activity android:name=".feature.login.LoginActivity" android:exported="true" />
        <activity android:name=".feature.signup.SignupActivity2" android:exported="false" />

        <activity android:name=".feature.scrap.ScrapActivity"/>
        <activity android:name=".feature.mypage.LikePostActivity" />
        <activity android:name=".feature.mypost.MyPostActivity" />
        <activity android:name=".feature.login.LoginActivity2" />
        <activity android:name=".feature.login.FindAccountActivity" />
        <activity android:name=".NwonSavedActivity" />

        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${KAKAO_REDIRECT_SCHEME}"
                    android:host="oauth"/>
            </intent-filter>
        </activity>
        <activity android:name=".WriteReviewActivity" />
        <activity android:name=".AllMyReviewActivity" />
        <activity android:name=".feature.mypage.ReviewEditActivity" />
        <activity android:name=".MyPageReviewsActivity" />
        <activity android:name=".feature.map.MyRegionActivity" />
        <activity android:name=".feature.board.CreateLifePostActivity" />
        <activity android:name=".BuyerReviewDetailActivity"
            android:exported="false" />
        <activity android:name=".chat.CancelDealActivity"/>
        <activity
            android:name=".EditPostActivity"
            android:exported="false" />
        <activity android:name=".SearchResultActivity" android:exported="false" />
        <activity android:name=".feature.mypage.RegionVerificationActivity" />
        <activity android:name=".SharingSellerProfileActivity" android:exported="false" />
        <activity
            android:name=".PurchaseSellerProfileActivity"
            android:exported="false" />
        <activity
            android:name=".SellerItemDetailActivity"
            android:exported="false" />
        <activity
            android:name=".FilteredBuyerReviewsActivity"
            android:exported="false" />
        <activity
            android:name=".MySaleItemsActivity"
            android:exported="false" />

        <service
            android:name=".feature.alarm.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
